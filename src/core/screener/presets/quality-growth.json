{
  "schemaVersion": 1,
  "id": "quality-growth",
  "title": {
    "en": "Quality growth",
    "ru": "Качественный рост"
  },
  "description": {
    "en": "Profitable growers: revenue and EPS both growing 15% a year or more over 3 years, a free cash flow margin of 10% or more and ROIC of 15% or more",
    "ru": "Прибыльный рост: выручка и EPS растут от 15% в год за 3 года, маржа свободного денежного потока от 10%, ROIC от 15%"
  },
  "appliesTo": [
    "stock"
  ],
  "match": "all",
  "conditions": [
    {
      "metric": "revenueGrowth3y",
      "op": ">=",
      "value": 15,
      "scope": "absolute",
      "missing": "fail"
    },
    {
      "metric": "epsGrowth3y",
      "op": ">=",
      "value": 15,
      "scope": "absolute",
      "missing": "fail"
    },
    {
      "metric": "fcfMargin",
      "op": ">=",
      "value": 10,
      "scope": "absolute",
      "missing": "fail"
    },
    {
      "metric": "roic",
      "op": ">=",
      "value": 15,
      "scope": "absolute",
      "missing": "fail"
    }
  ]
}
